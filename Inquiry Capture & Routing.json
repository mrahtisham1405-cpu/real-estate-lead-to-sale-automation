    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Full Name\nitem.json.fullName = (item.json.fullName || \"\").trim();\n\n// Phone Number Standardization\nlet phone = (item.json.phone || \"\").toString().replace(/\\D/g, \"\");\n\nif (phone.startsWith(\"0\")) {\n  phone = \"92\" + phone.slice(1);\n} else if (phone.length === 10) {\n  phone = \"92\" + phone;\n}\n\nitem.json.phone = phone;\n\n// Email\nitem.json.email = (item.json.email || \"\").trim().toLowerCase();\n\n// Property Details\nitem.json.propertyInterest = (item.json.propertyInterest || \"\").trim();\nitem.json.preferredLocation = (item.json.preferredLocation || \"\").trim();\n\n// Budget\nitem.json.budget = Number(item.json.budget) || 0;\n\n// Message\nitem.json.message = (item.json.message || \"\").trim();\n\n// Source\nitem.json.source = (item.json.source || \"Website\").trim();\n\n// Status\nitem.json.status = \"New\";\n\n// Timestamps\nconst now = new Date().toISOString();\nitem.json.createdAt = item.json.createdAt || now;\nitem.json.updatedAt = now;\n\n// Return Item\nreturn item;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
